// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     String @default("User")

  resetToken       String?
  resetTokenExpiry DateTime?
}

model News {
  id          Int       @id @default(autoincrement())
  tittle      String
  slug        String    @unique
  category    String
  excerpt     String
  content     String    @db.Text
  coverImage  String
  readingTime Int
  published   Boolean
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updateAt    DateTime  @updatedAt
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
}

model Creator {
  id                 Int      @id @default(autoincrement())
  name               String
  slug               String   @unique
  category           String
  profileImage       String?
  verified           Boolean  @default(false)
  /// Denormalized cache synced from SocialAccount for public display
  instagramUsername  String?
  instagramFollowers String?
  tiktokUsername     String?
  tiktokFollowers    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  socialAccounts SocialAccount[]
}

/// Source of truth for platform profile URLs and follower metrics.
/// Phase 1 stores followers only; columns for future metrics can be added later.
model SocialAccount {
  id               Int            @id @default(autoincrement())
  contentCreatorId Int
  platform         SocialPlatform
  username         String?
  profileUrl       String?
  followers        Int?
  /// Platform-specific verification (IG can be verified while TikTok is not)
  verified         Boolean        @default(false)
  lastSyncedAt     DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  contentCreator Creator @relation(fields: [contentCreatorId], references: [id], onDelete: Cascade)

  @@unique([contentCreatorId, platform])
  @@index([platform])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
