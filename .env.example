# Social follower sync (Phase 1)
# Daily cron is registered but does nothing unless this is true
SOCIAL_SYNC_ENABLED=false

# Optional external metrics API (preferred over public profile scrape)
# Expected endpoints:
#   GET {SOCIAL_METRICS_API_BASE_URL}/instagram/followers?username=...
#   GET {SOCIAL_METRICS_API_BASE_URL}/tiktok/followers?username=...
# Response JSON: { "followers": number | null }
# SOCIAL_METRICS_API_BASE_URL=
# SOCIAL_METRICS_API_KEY=
